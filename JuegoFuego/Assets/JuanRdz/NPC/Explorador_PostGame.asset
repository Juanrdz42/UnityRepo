  npcName: Explorador
  npcPortrait: {fileID: 21300000, guid: 8bbbdc64a79aa4c7fad407a203745d36, type: 3}
  dialogueLines:
  - "\xA1Hola otra vez! Veo que sigues explorando por aqu\xED."
  - "A\xFAn estoy reuniendo fotograf\xEDas de los biomas. \xBFQuieres ayudarme a
    tomar algunas m\xE1s? "
  - "\xA1Excelente! \xBFQu\xE9 bioma te interesa fotografiar hoy? "
  - 'El bosque tiene muchos animales interesantes. '
  - "\xBFEst\xE1s listo para comenzar? "
  - "Perfecto, prep\xE1rate. "
  - "El lago es perfecto para encontrar vida acu\xE1tica. "
  - "\xBFEst\xE1s listo para comenzar? "
  - "Perfecto, prep\xE1rate."
  - "De acuerdo. Si quieres tomar m\xE1s fotos despu\xE9s, ven a hablar conmigo. "
  typingSpeed: 0.05
  voiceSound: {fileID: 8300000, guid: ad349c48c682649c487697b641f246a8, type: 3}
  voicePitch: 1
